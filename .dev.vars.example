# Copy to .dev.vars for local development. Production sets each of these with `wrangler secret put`.
LAB_INGEST_TOKEN=dev-token-change-me
# Printer camera: the tunnel hostname and an Access service token. Leave CAMERA_URL empty to hide it.
CAMERA_URL=
CAMERA_ACCESS_CLIENT_ID=
CAMERA_ACCESS_CLIENT_SECRET=
# Sign in with GitHub: a separate OAuth App whose callback is http://localhost:5173/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Google: a Web application OAuth client with redirect URI http://localhost:5173/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate with `openssl rand -hex 32`.
SESSION_SECRET=
# Ask about my work: a Claude API key from platform.claude.com. Leave empty to hide the assistant.
ANTHROPIC_API_KEY=
