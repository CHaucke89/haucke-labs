{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haucke-labs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// No id: `wrangler deploy` provisions the namespace on first deploy.
	"kv_namespaces": [{ "binding": "LAB" }],
	// `wrangler preview` refuses to run without this block. Previews don't inherit bindings, so they have no LAB.
	"previews": {}
}