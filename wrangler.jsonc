{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "haucke-labs",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// No id: `wrangler deploy` provisions the namespace on first deploy.
	"kv_namespaces": [{ "binding": "LAB" }],
	// Also provisioned on first deploy. Migrations in ./migrations are applied by hand with
	// `wrangler d1 migrations apply haucke-labs`.
	"d1_databases": [{ "binding": "DB", "database_name": "haucke-labs" }],
	// Burst limit for /api/ask, per IP and per Cloudflare location. The daily caps live in D1.
	"ratelimits": [{ "name": "ASK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
	// `wrangler preview` refuses to run without this block. Previews don't inherit bindings, so they have no LAB, DB or ASK_LIMITER.
	"previews": {}
}